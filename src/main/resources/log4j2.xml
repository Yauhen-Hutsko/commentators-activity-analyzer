<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO" monitorInterval="300" >
    <Appenders>
        <!--Default root path is '{TomcatFolder}/bin/'-->
        <File name="file" fileName="../logs/main.log">
            <PatternLayout pattern="%d{DATE} [%t] %-5level %logger{36} - %msg%n"/>
        </File>
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <!--name for logger mustn't contain regExp symbols like com.hutsko.*-->
        <Logger name="com.hutsko" level="info" additivity="false">
            <AppenderRef ref="file"/>
        </Logger>
        <Root level="error">
            <AppenderRef ref="console"/>
        </Root>
    </Loggers>
</Configuration>