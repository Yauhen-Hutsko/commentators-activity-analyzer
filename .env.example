# Copy to `.env` (git-ignored) and fill in real values. Never commit `.env`.

# Database the app container reads from. host.docker.internal = your Mac's localhost.
DB_URL=jdbc:postgresql://host.docker.internal:5432/postgres
DB_USER=your_db_user
DB_PASSWORD=
DB_PROFILE_TABLE=user_profiles_enriched

# Only needed for `docker compose --profile sandbox up` (throwaway DB with sample rows).
SANDBOX_DB_USER=commentators
SANDBOX_DB_PASSWORD=change-me
